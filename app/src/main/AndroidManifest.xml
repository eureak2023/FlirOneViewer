<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.usb.host" android:required="true" />
    <!-- Android 9+ 는 USB 비디오(UVC) 장치에 접근하려면 카메라 권한이 있어야 USB 권한 창을 띄움 (UV 카메라 전용) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- fullUser: 자동 회전 잠금은 존중하면서 4방향(거꾸로 세로 포함) 모두 허용.
             Android 16 대화면(600dp 이상)에서는 시스템이 무시하지만 폰에서는 그대로 동작합니다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            tools:ignore="DiscouragedApi"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- FLIR ONE 연결 시 자동 실행 (원본 앱과 같은 방식) -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- UV 카메라(표준 UVC 웹캠). UVLOOK 앱과 같은 장치가 연결되면 바로 열림 -->
        <activity
            android:name=".UvcActivity"
            android:exported="true"
            android:label="@string/uvc_title"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            tools:ignore="DiscouragedApi"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/uvc_device_filter" />
        </activity>
    </application>
</manifest>
