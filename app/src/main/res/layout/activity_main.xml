<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 열화상: 화면 전체 -->
    <com.example.flironeviewer.ui.ThermalView
        android:id="@+id/thermalView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 촬영 플래시 -->
    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FFFFFFFF" />

    <!-- 카메라 미연결 안내 -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/emptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/status_no_device"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/emptyDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/empty_hint"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 상단 오버레이 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/chipStatus"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:text="@string/state_offline"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/chipEmissivity"
                style="@style/Chip"
                android:contentDescription="@string/btn_emissivity"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="@string/emissivity_chip_default" />

            <TextView
                android:id="@+id/chipBattery"
                style="@style/Chip"
                android:layout_marginStart="8dp"
                android:drawableStart="@drawable/ic_battery_small"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:text="@string/battery_unknown"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 측정값 -->
        <LinearLayout
            android:id="@+id/readout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:visibility="invisible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:shadowColor="#99000000"
                    android:shadowRadius="6"
                    android:text="@string/spot"
                    android:textColor="@color/accent"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/spotValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:shadowColor="#AA000000"
                    android:shadowRadius="10"
                    android:text="@string/temp_placeholder"
                    android:textColor="@color/text_primary"
                    android:textSize="48sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/maxValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:shadowColor="#AA000000"
                    android:shadowRadius="6"
                    android:textColor="@color/hot"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/minValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:shadowColor="#AA000000"
                    android:shadowRadius="6"
                    android:textColor="@color/cold"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 하단 오버레이 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- 팔레트 선택 (팔레트 버튼으로 열고 닫음) -->
        <HorizontalScrollView
            android:id="@+id/palettePanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_panel"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/paletteList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp" />
        </HorizontalScrollView>

        <!-- 모드 세그먼트 -->
        <LinearLayout
            android:id="@+id/modeSegment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView android:id="@+id/modeMsx" style="@style/Segment" android:text="@string/mode_msx" />
            <TextView android:id="@+id/modeThermal" style="@style/Segment" android:text="@string/mode_thermal" />
            <TextView android:id="@+id/modeVisual" style="@style/Segment" android:text="@string/mode_visual" />
            <TextView android:id="@+id/modeBlend" style="@style/Segment" android:text="@string/mode_blend" />
        </LinearLayout>

        <!-- 컨트롤 -->
        <LinearLayout
            android:baselineAligned="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <com.example.flironeviewer.ui.PaletteSwatchView
                    android:id="@+id/btnPalette"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/btn_palette"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless" />
            </FrameLayout>

            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <ImageButton
                    android:id="@+id/btnLock"
                    style="@style/RoundButton"
                    android:layout_gravity="center"
                    android:contentDescription="@string/btn_lock"
                    android:src="@drawable/ic_lock_open" />
            </FrameLayout>

            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4">
                <ImageButton
                    android:id="@+id/btnSnapshot"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter"
                    android:contentDescription="@string/btn_snapshot"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless" />
            </FrameLayout>

            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <ImageButton
                    android:id="@+id/btnRotate"
                    style="@style/RoundButton"
                    android:layout_gravity="center"
                    android:contentDescription="@string/btn_rotate"
                    android:src="@drawable/ic_rotate" />
            </FrameLayout>

            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                <ImageButton
                    android:id="@+id/btnSettings"
                    style="@style/RoundButton"
                    android:layout_gravity="center"
                    android:contentDescription="@string/btn_settings"
                    android:src="@drawable/ic_settings" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
