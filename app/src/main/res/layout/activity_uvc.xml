<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/uvcRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- UV 카메라 영상: 화면 전체 (터치하면 조작 UI 숨김/표시) -->
    <com.example.flironeviewer.ui.UvcView
        android:id="@+id/uvcView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/uvcFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#FFFFFFFF" />

    <!-- 카메라 미연결 안내 -->
    <LinearLayout
        android:id="@+id/uvcEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <TextView
            android:id="@+id/uvcEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/uvc_waiting"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/uvc_waiting_detail"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 상단: 상태 칩 + 표시 방식 -->
    <LinearLayout
        android:id="@+id/uvcTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                tools:ignore="UselessParent">

                <View
                    android:id="@+id/uvcDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot" />

                <TextView
                    android:id="@+id/uvcStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:text="@string/uvc_title"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/btnUvcScale"
            style="@style/Chip"
            android:contentDescription="@string/btn_scale"
            android:drawableStart="@drawable/ic_scale_original"
            android:drawablePadding="6dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/scale_original" />
    </LinearLayout>

    <!-- 하단 컨트롤 -->
    <LinearLayout
        android:id="@+id/uvcBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <ImageButton
                android:id="@+id/btnUvcAdjust"
                style="@style/RoundButton"
                android:layout_gravity="center"
                android:contentDescription="@string/uvc_adjust"
                android:src="@drawable/ic_tune" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <ImageButton
                android:id="@+id/btnUvcMirror"
                style="@style/RoundButton"
                android:layout_gravity="center"
                android:contentDescription="@string/btn_mirror"
                android:src="@drawable/ic_mirror" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4">
            <ImageButton
                android:id="@+id/btnUvcSnapshot"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_shutter"
                android:contentDescription="@string/btn_snapshot"
                android:foreground="?android:attr/selectableItemBackgroundBorderless" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <ImageButton
                android:id="@+id/btnUvcRotate"
                style="@style/RoundButton"
                android:layout_gravity="center"
                android:contentDescription="@string/btn_rotate"
                android:src="@drawable/ic_rotate" />
        </FrameLayout>

        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <ImageButton
                android:id="@+id/btnUvcResolution"
                style="@style/RoundButton"
                android:layout_gravity="center"
                android:contentDescription="@string/uvc_resolution"
                android:src="@drawable/ic_settings" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
